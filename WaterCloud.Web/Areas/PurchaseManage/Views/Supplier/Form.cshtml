@{
    ViewBag.Title = "Form";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'common', 'optimizeSelectOption'], function () {
        var form = layui.form,
            $ = layui.$,
            common = layui.common;
        var keyValue = $.request("keyValue");
        common.authorizeFields('adminform');
        $(function () {
            if (!!keyValue) {
                common.ajax({
                    url: '/PurchaseManage/Supplier/GetFormJson',
                    dataType: 'json',
                    data: { keyValue: keyValue },
                    async: false,
                    success: function (data) {
                        common.val('adminform', data);
                    }
                });
            }
            else {
                $('#F_SupplierCode').val("S-" + new Date().formatDate('yyyyMMddhhmmss'));
            }
            form.render();
        });
        wcLoading.close();
        form.on('submit(saveBtn)', function (data) {
            var postData = data.field;
            if (!postData["F_EnabledMark"]) postData["F_EnabledMark"] = false;
            common.submitForm({
                url: '/PurchaseManage/Supplier/SubmitForm?keyValue=' + keyValue,
                param: postData,
                success: function () {
                    common.parentreload('data-search-btn');
                }
            })
            return false;
        });
    });
</script>

<body>
    <div class="layuimini-container">
        <div class="layuimini-main">
            <div class="layui-form layuimini-form" lay-filter="adminform">
                <div class="layui-form-item">
                    <div class="layui-col-md6 layui-col-sm6">
                        <label class="layui-form-label required">供应商编号</label>
                        <div class="layui-input-block">
                            <input type="text" id="F_SupplierCode" name="F_SupplierCode" autocomplete="off" maxlength="50" lay-verify="required" placeholder="请输入供应商编号" class="layui-input">
                        </div>
                    </div>
                    <div class="layui-col-md6 layui-col-sm6">
                        <label class="layui-form-label required">供应商名称</label>
                        <div class="layui-input-block">
                            <input type="text" id="F_SupplierName" name="F_SupplierName" autocomplete="off" maxlength="100" lay-verify="required" placeholder="请输入供应商名称" class="layui-input">
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-col-md6 layui-col-sm6">
                        <label class="layui-form-label">联系人</label>
                        <div class="layui-input-block">
                            <input id="F_Contact" name="F_Contact" type="text" maxlength="50" autocomplete="off" placeholder="请输入联系人" class="layui-input"/>
                        </div>
                    </div>
                    <div class="layui-col-md6 layui-col-sm6">
                        <label class="layui-form-label">联系电话</label>
                        <div class="layui-input-block">
                            <input id="F_Phone" name="F_Phone" type="text" maxlength="50" autocomplete="off" placeholder="请输入联系电话" class="layui-input"/>
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-col-md12 layui-col-xs12">
                        <label class="layui-form-label">地址</label>
                        <div class="layui-input-block">
                            <input id="F_Address" name="F_Address" class="layui-input" placeholder="请输入地址">
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-col-md6 layui-col-sm6">
                        <label class="layui-form-label">启用</label>
                        <div class="layui-input-block">
                            <input type="checkbox" name="F_EnabledMark" id="F_EnabledMark" value="true" checked title="有效标识">
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-col-md12 layui-col-xs12">
                        <label class="layui-form-label">备注</label>
                        <div class="layui-input-block">
                            <input id="F_Description" name="F_Description" class="layui-input" placeholder="请输入备注">
                        </div>
                    </div>
                </div>
                <div class="layui-form-item text-right layui-hide">
                    <button class="layui-btn site-demo-active" lay-submit id="submit" lay-filter="saveBtn">确认保存</button>
                </div>
            </div>
        </div>
    </div>
</body>
