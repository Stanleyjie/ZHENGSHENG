@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>layui</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
</head>
<body>
    <div class="layuimini-container">
        <div class="layuimini-main">

            <fieldset class="table-search-fieldset layui-hide" id="searchField">
                <div>
                    <form class="layui-form layui-form-pane" action="">
                        <div class="layui-form-item">
                            <div class="layui-inline">
                                <label class="layui-form-label">日期:</label>
                                <div class="layui-input-block">
                                    <select id="time_horizon" name="time_horizon">
                                        <option value="1">今天</option>
                                        <option value="2" selected>近7天</option>
                                        <option value="3">近1个月</option>
                                        <option value="4">近2个月</option>
                                    </select>
                                </div>
                            </div>
                            <div class="layui-inline">
                                <label class="layui-form-label">日志类型:</label>
                                <div class="layui-input-block">
                                    <select id="log_type" name="log_type">
                                        <option value="-1" selected>全部</option>
                                        <option value="0">领料</option>
                                        <option value="1">产出</option>
                                        <option value="2">入库</option>
                                        <option value="3">出库</option>
                                        <option value="4">质检</option>
                                        <option value="5">设备维修</option>
                                        <option value="6">调度任务</option>
                                        <option value="7">工单</option>
                                        <option value="8">库位调整</option>
                                        <option value="9">其他</option>
                                    </select>
                                </div>
                            </div>
                            <div class="layui-inline">
                                <label class="layui-form-label">关键字:</label>
                                <div class="layui-input-inline">
                                    <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="操作人/内容/设备/工单/物料/流转箱">
                                </div>
                            </div>
                            <div class="layui-inline">
                                <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                            </div>
                        </div>
                    </form>
                </div>
            </fieldset>

            <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
        </div>
    </div>
    <script>
        layui.use(['jquery', 'form', 'table', 'common', 'optimizeSelectOption', 'commonTable'], function () {
            var $ = layui.jquery,
                form = layui.form,
                table = layui.table,
                commonTable = layui.commonTable,
                common = layui.common;
            //加载数据
            wcLoading.close();
            commonTable.rendertable({
                elem: '#currentTableId',
                id: 'currentTableId',
                url: '/SystemSecurity/BusinessLog/GetGridJson',
                cols: [[
                    { field: 'F_LogTypeName', title: '日志类型', width: 110, sort: true },
                    { field: 'F_Content', title: '操作内容', minWidth: 300 },
                    { field: 'F_OperationUser', title: '操作人', width: 120, sort: true },
                    { field: 'F_EqpName', title: '设备', width: 120, sort: true },
                    { field: 'F_WorkOrderCode', title: '工单编号', width: 180, sort: true },
                    { field: 'F_MaterialName', title: '物料', width: 120, sort: true },
                    { field: 'F_TransferBoxCode', title: '流转箱', width: 130, sort: true },
                    { field: 'F_Num', title: '数量', width: 100, sort: true },
                    {
                        field: 'F_CreatorTime', title: '操作时间', width: 180, sort: true,
                        templet: function (d) {
                            if (d.F_CreatorTime) {
                                return new Date(d.F_CreatorTime).Format("yyyy-MM-dd hh:mm:ss");
                            }
                            return '';
                        }
                    },
                    { fixed: 'right', title: '操作', width: 80, templet: '<div><a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="details">详情</a></div>' }
                ]]
            });
            // 监听搜索操作
            form.on('submit(data-search-btn)', function (data) {
                var queryJson = JSON.stringify(data.field);
                //执行搜索重载
                commonTable.reloadtable({
                    elem: 'currentTableId',
                    curr: 1,
                    where: { timetype: data.field.time_horizon, logType: data.field.log_type, keyword: data.field.txt_keyword }
                });
                return false;
            });
            table.on('tool(currentTableFilter)', function (obj) {
                var data = obj.data;
                if (obj.event === 'details') {
                    common.modalOpen({
                        title: "日志详情",
                        url: "/SystemSecurity/BusinessLog/Details?keyValue=" + data.F_Id,
                        width: "700px",
                        height: "480px",
                    });
                }
            });
        });
    </script>

</body>
</html>
